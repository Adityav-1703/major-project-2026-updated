{
  "name": "ayurvedic-blockchain-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "npx concurrently -n ml,api,web -c magenta,blue,green \"npm run ml\" \"npm run backend\" \"npm run dev\"",
    "all": "npm run dev:all",
    "ml": "python ml-service/app.py",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "backend": "npm run dev --prefix backend",
    "backend:seed": "npm run seed --prefix backend",
    "seed": "npm run seed --prefix backend"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.2.13",
    "i18next": "^26.0.3",
    "i18next-browser-languagedetector": "^8.2.1",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.441.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.2",
    "react-router-dom": "^6.26.1",
    "recharts": "^2.12.7",
    "tailwind-merge": "^2.5.2",
    "three": "^0.185.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/node": "^20.16.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.1",
    "@typescript-eslint/parser": "^8.0.1",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.7",
    "globals": "^15.9.0",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.5.3",
    "vite": "^5.4.1"
  }
}
